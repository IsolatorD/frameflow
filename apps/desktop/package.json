{
	"name": "@frameflow/desktop",
	"version": "0.6.0",
	"private": true,
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"smoke": "electron-vite build && node scripts/smoke.mjs",
		"icons": "node scripts/build-icons.mjs",
		"test": "vitest run",
		"bundle:remotion": "node scripts/bundle-remotion.mjs",
		"dist": "electron-vite build && node scripts/bundle-remotion.mjs && electron-builder --publish never"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.9.0",
		"@echogarden/espeak-ng-emscripten": "0.3.5",
		"@google/genai": "^3.4.0",
		"@huggingface/transformers": "^4.3.2",
		"@libsql/client": "~0.18.0",
		"@remotion/renderer": "4.0.543",
		"drizzle-orm": "~0.45.4",
		"electron-updater": "^6.8.11",
		"onnxruntime-node": "1.31.1",
		"openai": "^7.57.0",
		"remotion": "4.0.543",
		"tar": "^7.5.23",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@frameflow/core": "workspace:*",
		"@frameflow/db": "workspace:*",
		"@frameflow/renderer-remotion": "workspace:*",
		"@frameflow/ui": "workspace:*",
		"@remotion/bundler": "4.0.543",
		"@remotion/player": "4.0.543",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.107.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"electron": "^45.3.3",
		"electron-builder": "^26.18.0",
		"electron-vite": "^6.0.0",
		"playwright-core": "^1.65.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^7.18.5",
		"tailwindcss": "^4.3.5",
		"vite": "^8.3.8"
	},
	"license": "GPL-3.0-or-later",
	"description": "Estudio de escritorio para crear canales de videos animados cortos",
	"author": "Daniel Rodriguez",
	"homepage": "https://github.com/IsolatorD/frameflow",
	"productName": "Frameflow"
}
